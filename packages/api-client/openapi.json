              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "X-Moetopia-CSRF",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "maxLength": 43,
              "minLength": 43,
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthorizationDecisionInputBody"
              }
            }
          },
          "required": true
