      "get": {
        "operationId": "get-api-v1-account-authorizations-by-id",
        "parameters": [
          {
            "in": "header",
            "name": "Cookie",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "maxLength": 43,
              "minLength": 43,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizationOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountProblem"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Get API v1 account authorizations by ID"
      },
